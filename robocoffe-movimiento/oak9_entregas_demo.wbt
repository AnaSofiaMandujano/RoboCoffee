#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/Oak9_conCafe.proto"
EXTERNPROTO "../protos/MesaCafe.proto"

WorldInfo {
  info [
    "LabDST ITESO - RoboCoffe: entregas a 3 mesas en fila (1, 2 y 3 m) con la maquina de estados"
    "Mesas MesaCafe (RoundTable a escala real: 0.70 m de diametro, 0.76 m de alto) a la derecha del pasillo"
    "Base: o1 del robot en (0, 0) mirando a +x. Puntos de entrega (lineas amarillas): x = 1, 2, 3 m"
  ]
  title "OAK9 entregas a 3 mesas (demostracion)"
  basicTimeStep 8
  contactProperties [
    # llanta-piso: agarre (mu real <POR MEDIR>)
    ContactProperties {
      material1 "default"
      material2 "rueda"
      coulombFriction [
        1.0
      ]
      bounce 0
      softCFM 1e-05
    }
    # bola loca-piso: la bola gira libre en cualquier direccion -> ~sin friccion
    ContactProperties {
      material1 "default"
      material2 "bola"
      coulombFriction [
        0.0
      ]
      bounce 0
      softCFM 1e-05
    }
  ]
}
Viewpoint {
  orientation 0.1811 0.4874 -0.8542 0.8206
  position -1.3 2.1 1.9
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  translation 1.5 -0.2 0
  floorSize 4.4 2.0
  floorTileSize 0.5 0.5
  wallHeight 0.1
}
# base (estacion de carga): cuadro de 26 cm alrededor de o1
Pose {
  translation 0 0 0.0005
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.45 0.85 roughness 1 metalness 0 }
      geometry Box { size 0.26 0.26 0.001 }
    }
  ]
}
Pose {
  translation 1.0 0 0.0005
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.75 0.1 roughness 1 metalness 0 }
      geometry Box { size 0.02 0.26 0.001 }
    }
  ]
}
MesaCafe {
  translation 1.0 -0.5 0
  name "mesa 1"
}
Pose {
  translation 2.0 0 0.0005
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.75 0.1 roughness 1 metalness 0 }
      geometry Box { size 0.02 0.26 0.001 }
    }
  ]
}
MesaCafe {
  translation 2.0 -0.5 0
  name "mesa 2"
}
Pose {
  translation 3.0 0 0.0005
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.75 0.1 roughness 1 metalness 0 }
      geometry Box { size 0.02 0.26 0.001 }
    }
  ]
}
MesaCafe {
  translation 3.0 -0.5 0
  name "mesa 3"
}
# o1 (centro entre ruedas) en la base, mirando a +x
Oak9_conCafe {
  translation 0 0 0
  name "OAK9"
  controller "oak9_entregas"
  controllerArgs [
    "modo=demo"
    "puerto=0"
    "reversa=0"
    "entrega=5"
  ]
  supervisor TRUE
}
